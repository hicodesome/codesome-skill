{
    "name": "codesome-cli",
    "version": "0.5.8",
    "description": "Codesome CLI for Codesome and Sub2API account, token, key, and skill management.",
    "license": "Apache-2.0",
    "author": "Codesome",
    "homepage": "https://github.com/hicodesome/codesome-skill#readme",
    "repository": {
        "type": "git",
        "url": "git+https://github.com/hicodesome/codesome-skill.git"
    },
    "bugs": {
        "url": "https://github.com/hicodesome/codesome-skill/issues"
    },
    "keywords": [
        "codesome",
        "sub2api",
        "cli",
        "agent",
        "skills",
        "token",
        "api-key"
    ],
    "type": "module",
    "bin": {
        "codesome": "./bin/codesome.js",
        "codesome-hotskills": "./bin/codesome-hotskills.js"
    },
    "files": [
        "bin/",
        "src/",
        "scripts/",
        "references/",
        "install.sh",
        "install.ps1",
        "checksums.txt",
        "README.md",
        "BUILD.md",
        "TESTING.md",
        "SECURITY.md",
        "CHANGELOG.md",
        "SKILL.md",
        "LICENSE"
    ],
    "publishConfig": {
        "access": "public",
        "provenance": true
    },
    "scripts": {
        "start": "node ./bin/codesome.js",
        "test:smoke": "npm run test:unix-entry && npm run test:windows-installer && npm run test:json-safety && node ./bin/codesome.js --help && node ./bin/codesome.js version && node ./bin/codesome.js auth status && node ./bin/codesome-hotskills.js --help",
        "test:unix-entry": "node ./scripts/verify-unix-entry-line-endings.cjs",
        "test:windows-installer": "node ./scripts/verify-windows-installer.cjs",
        "test:repair-scripts": "node ./scripts/verify-repair-scripts.cjs",
        "test:json-safety": "node ./scripts/test-json-safety.cjs",
        "test:npm-pack": "node ./scripts/verify-npm-package.cjs",
        "prepublishOnly": "npm run test:unix-entry && npm run test:repair-scripts && npm run test:json-safety && npm run scan:public-safety && npm run test:auth-http && npm run test:instance && npm run test:key-config && npm run test:auto-sync && npm run test:pagination-usage && npm run test:multi-account && npm run test:redeem && npm run test:hotskills-install && npm run test:password-prompt && npm run test:hotskills-snapshot && npm run test:smoke && npm run test:npm-pack",
        "scan:public-safety": "node ./scripts/scan-public-safety.cjs --public",
        "test:auth-http": "node ./scripts/test-auth-http-mock.cjs",
        "test:instance": "node ./scripts/test-instance-mock.cjs",
        "test:key-config": "node ./scripts/test-key-config-mock.cjs",
        "test:hotskills-upstream": "node ./scripts/check-hotskills-upstream.cjs",
        "test:hotskills-snapshot": "node ./scripts/update-hotskills-snapshot.cjs",
        "hotskills:snapshot": "node ./scripts/update-hotskills-snapshot.cjs --write",
        "test:pagination-usage": "node ./scripts/test-pagination-usage-mock.cjs",
        "test:multi-account": "node ./scripts/test-multi-account-mock.cjs",
        "test:redeem": "node ./scripts/test-redeem-mock.cjs",
        "build:release": "node ./scripts/build-release.mjs && node ./scripts/verify-release-assets.cjs",
        "test:hotskills-install": "node ./scripts/test-hotskills-install-command.cjs",
        "test:password-prompt": "node ./scripts/test-password-prompt.cjs",
        "test:auto-sync": "node ./scripts/test-auto-sync-mock.cjs"
    },
    "dependencies": {
        "ws": "^8.20.0"
    },
    "engines": {
        "node": ">=18"
    },
    "devDependencies": {
        "esbuild": "^0.28.0",
        "pkg": "^5.8.1"
    }
}
