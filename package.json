{
    "name": "@codesome/cli",
    "version": "0.5.1-rc.2",
    "private": true,
    "description": "Private Codesome CLI workspace",
    "type": "module",
    "bin": {
        "codesome": "./bin/codesome.js",
        "codesome-hotskills": "./bin/codesome-hotskills.js"
    },
    "scripts": {
        "start": "node ./bin/codesome.js",
        "test:smoke": "npm run test:unix-entry && npm run test:json-safety && node ./bin/codesome.js --help && node ./bin/codesome.js version && node ./bin/codesome.js auth status",
        "test:unix-entry": "node ./scripts/verify-unix-entry-line-endings.cjs",
        "test:json-safety": "node ./scripts/test-json-safety.cjs",
        "scan:public-safety": "node ./scripts/scan-public-safety.cjs --public",
        "test:auth-http": "node ./scripts/test-auth-http-mock.cjs",
        "test:instance": "node ./scripts/test-instance-mock.cjs",
        "test:key-config": "node ./scripts/test-key-config-mock.cjs",
        "test:multi-account": "node ./scripts/test-multi-account-mock.cjs",
        "test:redeem": "node ./scripts/test-redeem-mock.cjs",
        "build:release": "node ./scripts/build-release.mjs"
    },
    "dependencies": {
        "ws": "^8.20.0"
    },
    "engines": {
        "node": ">=20"
    },
    "devDependencies": {
        "esbuild": "^0.28.0",
        "pkg": "^5.8.1"
    }
}
